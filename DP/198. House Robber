class Solution {
    static int solve(int i,int[] nums,int[] dp){
        int n=nums.length;
        if(i>=n){
            return 0;
        }
        if(dp[i]!=-1){
            return dp[i];
        }
        int pick=nums[i]+solve(i+2,nums,dp);
        int dontpick=solve(i+1,nums,dp);
        return dp[i]= Math.max(pick,dontpick);
    }
   public int rob(int [] nums){
    int n=nums.length;
    int dp[]=new int[n];
    for(int i=0;i<n;i++){
        dp[i]=-1;
    }
    return solve(0,nums,dp);
   }
}
